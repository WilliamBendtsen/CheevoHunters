PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATA_PROVIDER=mock

# Copy this file to `.env` and fill in real values locally.
# Keep `.env` out of git and do not paste secrets into chat/history.

# Supabase/Postgres. Only required when DATA_PROVIDER=supabase.
DATABASE_URL=your_supabase_postgres_connection_string_here
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# IGDB/Twitch. Only required when adding real IGDB game data.
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
IGDB_API_BASE_URL=https://api.igdb.com/v4
