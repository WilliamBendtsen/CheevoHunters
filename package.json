{
  "name": "cheevohunters-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon --watch server --exec node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch server --exec node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test:server": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "concurrently": "^8.2.0",
    "express": "^4.18.2",
    "nodemon": "^3.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.3.6"
  }
}
