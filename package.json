{
  "name": "cheevohunters-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon --watch server --watch .env --ext js,mjs,cjs,json,env --exec node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch server --watch .env --ext js,mjs,cjs,json,env --exec node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test:server": "node --test server/tests/*.test.js",
    "db:schema": "node server/scripts/run-sql-file.js server/db/schema.sql",
    "db:seed": "node server/scripts/run-sql-file.js server/db/seed.sql",
    "igdb:sync-covers": "node server/scripts/sync-igdb-covers.js",
    "storage:setup": "node server/scripts/setup-avatar-storage.js"
  },
  "dependencies": {
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lucide-react": "^1.47.0",
    "nodemon": "^3.0.1",
    "pg": "^8.23.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.3.6"
  }
}
